# File path: /etc/systemd/system/smart-gateway.service
# sudo systemctl daemon-reload
# sudo systemctl start smart-gateway
# sudo systemctl enable smart-gateway
# sudo systemctl status smart-gateway
[Unit]
Description=Smart Gateway Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/smart-gateway  # 注意修改路径
ExecStart=/path/to/smart-gateway/smart-gateway --port 3000 --log-dir /path/to/smart-gateway/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
